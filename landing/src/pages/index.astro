---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Roomies",
  "description": "Smart roommate management for rent, expenses, and chores. Split bills, track shared costs, and keep your household running smoothly.",
  "url": "https://roomies.app",
  "applicationCategory": "LifestyleApplication",
  "operatingSystem": "Web, iOS, Android",
  "browserRequirements": "Requires JavaScript",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "1247"
  },
  "featureList": ["Rent splitting", "Expense tracking", "Chore management", "Roommate communication", "Payment reminders"]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is Roomies really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Roomies is free for households of up to 4 people. Our premium plan unlocks unlimited roommates, advanced analytics, and integrations with banking apps."
      }
    },
    {
      "@type": "Question",
      "name": "How does rent splitting work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can split rent equally among all roommates, or proportionally based on room size. Roomies tracks each person's share and sends automatic payment reminders."
      }
    },
    {
      "@type": "Question",
      "name": "What platforms is Roomies available on?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Roomies is available as a web app, iOS app, and Android app. All platforms sync in real-time so everyone stays up to date."
      }
    },
    {
      "@type": "Question",
      "name": "Is my financial data secure?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. We use bank-level encryption and never store your banking credentials. All financial data is encrypted at rest and in transit."
      }
    }
  ]
};
---

<BaseLayout
  title="Roomies - Smart Roommate Management for Rent, Expenses & Chores"
  description="Roomies makes sharing a home effortless. Split rent, track expenses, assign chores, and communicate with your roommates — all in one beautiful app."
  image="/og-image.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>

<main id="main-content" class="flex flex-col">

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-indigo-50 via-white to-purple-50" aria-labelledby="hero-heading">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-indigo-100 rounded-full opacity-50 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-purple-100 rounded-full opacity-50 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-r from-indigo-50 to-purple-50 rounded-full opacity-30 blur-3xl"></div>
    </div>

    <div class="relative container-custom py-32 md:py-40 text-center">
      <div class="inline-flex items-center gap-2 bg-indigo-50 border border-indigo-100 rounded-full px-4 py-1.5 text-sm font-medium text-indigo-700 mb-8">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
        </span>
        Now in early access — Join the waitlist
      </div>

      <h1 id="hero-heading" class="heading-xl mb-6 max-w-4xl mx-auto">
        Make Roommate Life
        <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent"> Effortless</span>
      </h1>

      <p class="text-body max-w-2xl mx-auto mb-10 text-lg md:text-xl text-gray-600">
        Split rent, track shared expenses, manage chores, and communicate with your roommates — all in one beautiful app designed for modern living.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a href="#signup" class="btn-primary text-base px-8 py-4 shadow-lg shadow-indigo-200 hover:shadow-xl hover:shadow-indigo-300 transition-shadow">
          Get Early Access
          <svg class="w-5 h-5 ml-2 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
        <a href="#how-it-works" class="btn-secondary text-base px-8 py-4">
          See How It Works
        </a>
      </div>

      <!-- Hero illustration / app mockup -->
      <div class="relative max-w-3xl mx-auto">
        <div class="bg-white rounded-2xl shadow-2xl shadow-gray-200/50 border border-gray-100 p-2 md:p-4">
          <div class="bg-gradient-to-br from-gray-50 to-white rounded-xl p-6 md:p-8">
            <!-- Dashboard preview mockup -->
            <div class="grid grid-cols-3 gap-4 mb-6">
              <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
                <div class="text-sm text-gray-500 mb-1">Monthly Rent</div>
                <div class="text-2xl font-bold text-gray-900">$1,200</div>
                <div class="text-xs text-indigo-600 mt-1">Split 4 ways = $300 each</div>
              </div>
              <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
                <div class="text-sm text-gray-500 mb-1">Shared Expenses</div>
                <div class="text-2xl font-bold text-gray-900">$186</div>
                <div class="text-xs text-green-600 mt-1">All settled up</div>
              </div>
              <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
                <div class="text-sm text-gray-500 mb-1">Chores Due</div>
                <div class="text-2xl font-bold text-gray-900">3</div>
                <div class="text-xs text-amber-600 mt-1">2 completed today</div>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex items-center gap-3 bg-white rounded-lg p-3 shadow-sm border border-gray-100">
                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-semibold text-sm">AK</div>
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">Alex K. paid $45 for groceries</div>
                  <div class="text-xs text-gray-500">2 hours ago</div>
                </div>
                <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full">Paid</span>
              </div>
              <div class="flex items-center gap-3 bg-white rounded-lg p-3 shadow-sm border border-gray-100">
                <div class="w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center text-purple-600 font-semibold text-sm">MR</div>
                <div class="flex-1">
                  <div class="text-sm font-medium text-gray-900">Maya R. needs to split the electric bill</div>
                  <div class="text-xs text-gray-500">5 hours ago</div>
                </div>
                <span class="text-xs font-medium text-amber-600 bg-amber-50 px-2 py-1 rounded-full">Pending</span>
              </div>
            </div>
          </div>
        </div>
        <!-- Decorative glow behind mockup -->
        <div class="absolute -inset-4 bg-gradient-to-r from-indigo-200 to-purple-200 rounded-3xl blur-2xl opacity-20 -z-10"></div>
      </div>
    </div>
  </section>

  <!-- Social Proof / Avatar Stack -->
  <section class="py-12 bg-white border-y border-gray-100" aria-label="Join the waitlist">
    <div class="container-custom">
      <p class="text-center text-sm font-medium text-gray-400 uppercase tracking-wider mb-8">Built for the way people actually live</p>
      <p class="text-center text-sm font-medium text-gray-400 mb-6">
        Join 1,247 roommates on the waitlist
      </p>
      <div class="flex items-center justify-center gap-2">
        <div class="flex -space-x-2">
          <div class="w-8 h-8 rounded-full bg-indigo-100 border-2 border-white flex items-center justify-center text-indigo-600 font-semibold text-xs ring-2 ring-white" aria-label="SK">SK</div>
          <div class="w-8 h-8 rounded-full bg-green-100 border-2 border-white flex items-center justify-center text-green-600 font-semibold text-xs ring-2 ring-white" aria-label="MR">MR</div>
          <div class="w-8 h-8 rounded-full bg-purple-100 border-2 border-white flex items-center justify-center text-purple-600 font-semibold text-xs ring-2 ring-white" aria-label="AK">AK</div>
          <div class="w-8 h-8 rounded-full bg-amber-100 border-2 border-white flex items-center justify-center text-amber-600 font-semibold text-xs ring-2 ring-white" aria-label="+1.2k more">+1.2k</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="section bg-white" aria-labelledby="features-heading">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 id="features-heading" class="heading-lg mb-4">Everything Your Household Needs</h2>
        <p class="text-body text-lg">Roomies handles all the messy parts of shared living so you can focus on what matters.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1: Rent Splitting -->
        <article class="group bg-gradient-to-br from-indigo-50 to-white rounded-2xl p-8 border border-indigo-100 hover:shadow-lg hover:shadow-indigo-100/50 transition-all duration-300">
          <div class="w-14 h-14 bg-indigo-100 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="heading-md mb-3">Smart Rent Splitting</h3>
          <p class="text-body-sm">Split rent fairly regardless of room sizes. Supports equal splits, proportional splits, and custom allocations. Automatic reminders when payments are due.</p>
        </article>

        <!-- Feature 2: Expense Tracking -->
        <article class="group bg-gradient-to-br from-green-50 to-white rounded-2xl p-8 border border-green-100 hover:shadow-lg hover:shadow-green-100/50 transition-all duration-300">
          <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
          </div>
          <h3 class="heading-md mb-3">Expense Tracking</h3>
          <p class="text-body-sm">Log shared purchases, categorize expenses, and track who owes what. Settle up with one tap or keep running tabs over time. Export reports for tax season.</p>
        </article>

        <!-- Feature 3: Chore Management -->
        <article class="group bg-gradient-to-br from-amber-50 to-white rounded-2xl p-8 border border-amber-100 hover:shadow-lg hover:shadow-amber-100/50 transition-all duration-300">
          <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="heading-md mb-3">Chore Management</h3>
          <p class="text-body-sm">Create rotating chore schedules, assign tasks to roommates, and track completion. Set recurring tasks and get notified when chores are due.</p>
        </article>

        <!-- Feature 4: Communication -->
        <article class="group bg-gradient-to-br from-purple-50 to-white rounded-2xl p-8 border border-purple-100 hover:shadow-lg hover:shadow-purple-100/50 transition-all duration-300">
          <div class="w-14 h-14 bg-purple-100 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 class="heading-md mb-3">Household Chat</h3>
          <p class="text-body-sm">Dedicated chat channels for your household. Discuss plans, share updates, and keep all household communication in one place — no more group chat chaos.</p>
        </article>

        <!-- Feature 5: Calendar & Reminders -->
        <article class="group bg-gradient-to-br from-rose-50 to-white rounded-2xl p-8 border border-rose-100 hover:shadow-lg hover:shadow-rose-100/50 transition-all duration-300">
          <div class="w-14 h-14 bg-rose-100 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="heading-md mb-3">Calendar & Reminders</h3>
          <p class="text-body-sm">Shared household calendar for move-in dates, lease renewals, and maintenance schedules. Smart reminders for rent, bills, and upcoming due dates.</p>
        </article>

        <!-- Feature 6: Analytics -->
        <article class="group bg-gradient-to-br from-cyan-50 to-white rounded-2xl p-8 border border-cyan-100 hover:shadow-lg hover:shadow-cyan-100/50 transition-all duration-300">
          <div class="w-14 h-14 bg-cyan-100 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="heading-md mb-3">Spending Insights</h3>
          <p class="text-body-sm">Visual dashboards showing spending patterns, upcoming obligations, and household budget health. Know exactly where your money goes each month.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section id="how-it-works" class="section bg-gray-50" aria-labelledby="how-heading">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 id="how-heading" class="heading-lg mb-4">Get Started in Minutes</h2>
        <p class="text-body text-lg">No complicated setup. Get your household running smoothly in three simple steps.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Step 1 -->
        <div class="relative">
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center h-full">
            <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-6">1</div>
            <h3 class="heading-md mb-3">Create Your Household</h3>
            <p class="text-body-sm">Sign up, create your household profile, and invite your roommates with a simple link or email.</p>
          </div>
          <!-- Connector line (desktop only) -->
          <div class="hidden md:block absolute top-1/2 -right-4 w-8 border-t-2 border-dashed border-gray-200"></div>
        </div>

        <!-- Step 2 -->
        <div class="relative">
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center h-full">
            <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-6">2</div>
            <h3 class="heading-md mb-3">Set Up Your Finances</h3>
            <p class="text-body-sm">Add your rent, utilities, and any shared expenses. Roomies automatically calculates each person's share.</p>
          </div>
          <div class="hidden md:block absolute top-1/2 -right-4 w-8 border-t-2 border-dashed border-gray-200"></div>
        </div>

        <!-- Step 3 -->
        <div class="relative">
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center h-full">
            <div class="w-12 h-12 bg-indigo-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-6">3</div>
            <h3 class="heading-md mb-3">Live Your Best Life</h3>
            <p class="text-body-sm">Track expenses, manage chores, and communicate — all automatically. Focus on being roommates, not accountants.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials" class="section bg-white" aria-labelledby="testimonials-heading">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 id="testimonials-heading" class="heading-lg mb-4">Loved by Roommates Everywhere</h2>
        <p class="text-body text-lg">Don't just take our word for it — hear from people who've transformed their shared living experience.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Testimonial 1 -->
        <blockquote class="bg-gradient-to-br from-indigo-50 to-white rounded-2xl p-8 border border-indigo-100">
          <div class="flex items-center gap-1 mb-4" aria-label="5 out of 5 stars">
            <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <p class="text-gray-700 mb-6 italic">"We went from constant arguments about who owed what to having zero money stress. Roomies completely changed our household dynamic."</p>
          <footer class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-semibold text-sm">SJ</div>
            <div>
              <cite class="not-italic font-semibold text-gray-900 text-sm">Sarah J.</cite>
              <p class="text-xs text-gray-500">College student, 4 roommates</p>
            </div>
          </footer>
        </blockquote>

        <!-- Testimonial 2 -->
